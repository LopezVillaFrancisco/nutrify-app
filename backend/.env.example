# Copiá este archivo a backend/.env (no se sube a git) o poné las variables en el hosting.

# Supabase: Project Settings → API → Project URL (la misma que NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Solo para proyectos que todavía firman con el secreto viejo (HS256). Los nuevos usan claves públicas: dejalo vacío.
SUPABASE_JWT_SECRET=

# Postgres: Supabase → Connect → Session pooler (anda con IPv4). Usuario "postgres.TU-PROYECTO".
# Las consultas corren con RLS como el usuario del token (ver UserDb.java).
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres
DB_USER=postgres.TU-PROYECTO
DB_PASSWORD=

# Desde dónde se puede llamar al backend (la app de Next), separado por comas
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3100

# Las mismas de antes (solo servidor)
FDC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# AI_DISABLED=1 apaga la IA para todos; TRANSLATE_DISABLED=1 no usa el traductor gratuito
AI_DISABLED=
TRANSLATE_DISABLED=
